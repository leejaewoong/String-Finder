{
  "appId": "com.yourcompany.stringfinder",
  "productName": "String-Finder",
  "copyright": "Copyright © 2025",
  "electronDownload": {
    "cache": "${TMPDIR}/electron-download"
  },
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "build/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "PATCH_NOTES.md",
      "to": "PATCH_NOTES.md"
    },
    {
      "from": ".env.example",
      "to": ".env.example"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "signingHashAlgorithms": ["sha256"],
    "signDlls": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "String-Finder"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  }
}
